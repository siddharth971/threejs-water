{
  "name": "webgl-water-threejs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\"",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "gh-pages": "^6.3.0",
    "prettier": "^3.8.4",
    "typescript": "^5.4.0",
    "vite": "^6.4.3",
    "vite-plugin-glsl": "^1.3.0"
  },
  "dependencies": {
    "babylonjs": "^9.28.0",
    "babylonjs-gui": "^9.28.0",
    "babylonjs-loaders": "^9.28.0",
    "babylonjs-materials": "^9.28.0",
    "node-unrar-js": "^2.0.2"
  }
}
